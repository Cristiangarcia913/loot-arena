# Copia este archivo a contracts/.env y rellénalo. NUNCA subas .env a git.

# URL RPC de Sepolia (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY

# Clave privada de la cuenta que desplegará el contrato (será el owner).
# Usa una wallet SOLO para pruebas. Con o sin prefijo 0x.
PRIVATE_KEY=

# API key de Etherscan (https://etherscan.io/myapikey) para verificar el contrato
ETHERSCAN_API_KEY=
