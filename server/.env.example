# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.

# RPC de Sepolia (Alchemy/Infura) o nodo local de Hardhat
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY
# RPC_URL=http://127.0.0.1:8545

# Clave privada del owner del contrato GameItem (con 0x delante)
PRIVATE_KEY=0xTU_CLAVE_PRIVADA

# Dirección del contrato desplegado (ver ../shared/deployments.json)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

PORT=3000

# Origen de la web para CORS (p. ej. https://loot-arena.netlify.app). "*" = cualquiera.
# Admite varios separados por comas.
ALLOWED_ORIGIN=*

# --- Opcionales ---
# Probabilidad de drop por victoria (0..1). Por defecto 0.6
DROP_CHANCE=0.6
# Número de proxies delante del servidor (Render/Railway = 1) para leer bien la IP real
TRUST_PROXY=1
