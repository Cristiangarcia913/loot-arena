# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.

# RPC de Sepolia (Alchemy/Infura) o nodo local de Hardhat
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY
# RPC_URL=http://127.0.0.1:8545

# Clave privada del owner del contrato GameItem (con 0x delante)
PRIVATE_KEY=0xTU_CLAVE_PRIVADA

# Dirección del contrato desplegado (ver ../shared/deployments.json)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

PORT=3000

# Origen de la web para CORS (p. ej. https://loot-arena.netlify.app). "*" = cualquiera.
# Admite varios separados por comas.
ALLOWED_ORIGIN=*

# --- Opcionales ---
# Probabilidad de drop por victoria (0..1). Por defecto 0.6
DROP_CHANCE=0.6
# Número de proxies delante del servidor (Render/Railway = 1) para leer bien la IP real
TRUST_PROXY=1

# --- 1.2: ranking on-chain y recompensas (opcionales) ---
# Si faltan, GET /ranking y POST /recompensa responden 503; /ganar sigue funcionando.
# Direcciones públicas (ver ../shared/deployments.json: sepolia.mercado y sepolia.recompensas)
MERCADO_ADDRESS=
RECOMPENSAS_ADDRESS=
# Dirección de LootGold (sepolia.oro). Sin ella, GET /tesoreria responde 503.
ORO_ADDRESS=
# Bloque desde el que indexar el ranking: el del despliegue de GameItem (el más antiguo)
DEPLOY_BLOCK=
# Inicio de la temporada 1 del pase (ISO UTC); debe coincidir con web/js/pase.js
# TEMPORADA_INICIO=2026-11-02T00:00:00Z

# --- 1.4.1: red de trabajo (fase E4) ---
# sepolia (por defecto), base-sepolia, arbitrum-sepolia, optimism-sepolia, localhost…
# El servidor atiende UNA red; para otra, se levanta un segundo servicio. Si RED y RPC_URL
# no coinciden en chainId, el servidor NO arranca y lo dice. Ver README §Trabajar en otra red.
RED=sepolia

# --- 1.4: persistencia (opcional, pero MUY recomendable en Render) ---
# Sin esto, la racha diaria, el primer botín, el tope del grifo de gas, los récords de
# la torre y el pity del botín se PIERDEN cada vez que Render reinicia o duerme el
# servicio. Ver README §Persistencia (paso a paso de Upstash, gratis y sin tarjeta).
#
# "memoria" (por defecto) o "upstash". Si se deja vacío y hay URL + token, usa upstash.
ALMACEN=
# Pestaña REST de la base de datos en la consola de Upstash (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
# Token REST "Standard" (NO el de solo lectura). Es un SECRETO: nunca a git.
UPSTASH_REDIS_REST_TOKEN=
# Prefijo de las claves; cámbialo para que dos entornos compartan una base gratuita.
# ALMACEN_PREFIJO=loot-arena:
